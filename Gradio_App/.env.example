# Target Organization Configuration
TARGET_ORGANIZATION=Đại học Nam Cần Thơ
TARGET_ALIASES=ĐH DNC, DNC, Trường DNC, Nam Cần Thơ

# Social Media Source (options: mock, facebook, rss)
SOCIAL_PLATFORM=mock
TARGET_PAGES=dnc_confessions, fanpage_dnc, forum_sinhvien

# Public Source Discovery Timeout & Retries
DISCOVERY_TIMEOUT_SECONDS=10
DISCOVERY_MAX_RETRIES=1

# Pipeline Scheduler
SCHEDULE_INTERVAL_MINUTES=60

# AI Sentiment Threshold (0.0 to 1.0)
SENTIMENT_THRESHOLD=0.80

# Alerting Channel (options: telegram, slack, email, mock, all)
ALERT_CHANNEL=mock

# Telegram Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Slack Credentials
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Credentials
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
ALERT_RECEIVER_EMAIL=admin_receiver@example.com

# System Storage Paths
DB_PATH=data/social_listening.db
LOG_FILE=logs/system.log
